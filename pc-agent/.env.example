# Copy to .env. The pairing token authorizes the mobile app/backend to talk
# to this agent — treat it like a password. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PC_AGENT_PAIRING_TOKEN=change-me

# Bind address. 127.0.0.1 (default) is not reachable from other devices —
# only change this if you understand the exposure and are on a trusted
# network, and even then prefer a Tailscale/VPN address over 0.0.0.0.
PC_AGENT_HOST=127.0.0.1
PC_AGENT_PORT=8765

# Max requests per minute per client, across all endpoints.
PC_AGENT_RATE_LIMIT_PER_MINUTE=30
