# Copy to .env and fill in as needed. Nothing here has a default that talks
# to a real cloud provider — the backend runs fully in "mock" mode with no
# keys set at all, so a fresh checkout works offline.

# Comma-separated bearer tokens accepted by the auth dependency. Generate
# with e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
JARVIS_AUTH_TOKENS=dev-local-token

# sqlite (default, zero setup) or a postgresql:// URL for production.
JARVIS_DATABASE_URL=sqlite:///./jarvis.db

# "mock" (default, deterministic, no network) or "anthropic" for real Claude
# reasoning/vision (see app/services/anthropic_reasoning.py and
# anthropic_vision.py).
JARVIS_REASONING_PROVIDER=mock
JARVIS_VISION_PROVIDER=mock

# Only read when the corresponding *_PROVIDER above is "anthropic". If left
# empty, the Anthropic SDK falls back to its own credential resolution
# (ANTHROPIC_API_KEY env var, or an `ant auth login` profile) — see
# docs/SETUP_BACKEND.md. Never commit real values.
JARVIS_REASONING_API_KEY=
JARVIS_VISION_API_KEY=

# Defaults to Claude Opus 5. Override for cost-sensitive personal use, e.g.
# claude-sonnet-5 or claude-haiku-4-5.
JARVIS_ANTHROPIC_MODEL=claude-opus-5

JARVIS_LOG_LEVEL=info
